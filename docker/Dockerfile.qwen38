# Dockerfile for serving Qwen/Qwen3.8-27B (Qwen3.5 hybrid GDN) on TPU v6e
# via tpu-inference (torchax path). Derived from docker/Dockerfile but:
#   * pins the exact vLLM commit from .buildkite/vllm_lkg.version
#   * installs tpu-inference from the port branch (contains the
#     --language-model-only vision-precompile fix)
#   * bakes in the model's required env vars and serve command.
#
# Build:
#   docker build -f docker/Dockerfile.qwen38 -t <repo>/qwen38-tpu:latest .
# Run (on a TPU VM, or GKE TPU node with TPU device plugin):
#   docker run --rm -p 8000:8000 <repo>/qwen38-tpu:latest

ARG BASE_IMAGE="python:3.12-slim-bookworm"
FROM $BASE_IMAGE

# Pinned by the tpu-inference repo (.buildkite/vllm_lkg.version).
ARG VLLM_COMMIT_HASH="a7a204cc6ec99b375985e564f4f271e68ee8f5b8"
# Fork + branch that carries the serve fix for Qwen3.8-27B.
ARG TPU_INFERENCE_REPO="https://github.com/shivajid/tpu-inference.git"
ARG TPU_INFERENCE_REF="port/qwen3.8-27b"

RUN pip install --upgrade pip

RUN apt-get update && apt-get install -y \
    git \
    libopenmpi-dev \
    libomp-dev \
    procps \
    curl \
    netcat-openbsd \
    wget \
    ca-certificates \
    build-essential \
    cmake \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# ---- Build vLLM at the pinned commit (TPU target) ----
WORKDIR /workspace/vllm
RUN git clone --filter=blob:none --no-checkout \
        https://github.com/vllm-project/vllm.git . && \
    git fetch --depth 1 origin ${VLLM_COMMIT_HASH} && \
    git checkout ${VLLM_COMMIT_HASH}

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --extra-index-url https://download.pytorch.org/whl/cpu \
        -r requirements/tpu.txt --retries 3
RUN --mount=type=cache,target=/root/.cache/pip \
    VLLM_TARGET_DEVICE="tpu" pip install --no-build-isolation -e .

# ---- Install tpu-inference from the port branch ----
WORKDIR /workspace/tpu_inference
RUN git clone ${TPU_INFERENCE_REPO} . && git checkout ${TPU_INFERENCE_REF}
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --extra-index-url https://download.pytorch.org/whl/cpu \
        -r requirements.txt --retries 3
RUN --mount=type=cache,target=/root/.cache/pip pip install -e .

# ---- Model/runtime environment for Qwen3.8-27B (torchax path) ----
ENV MODEL_IMPL_TYPE=vllm \
    NEW_MODEL_DESIGN=1 \
    SLICE_ROPE_CACHE=1 \
    RAGGED_GATED_DELTA_RULE_IMPL=chunked_kernel_p_recurrent_kernel_d \
    # Persistent XLA compilation cache inside the container; mount a volume
    # here on GKE to share/reuse across pods, or let the bake-in layer fill it.
    JAX_COMPILATION_CACHE_DIR=/jax_cache \
    # Weights cache. Override to a mounted GCSFuse/PD volume on GKE to avoid
    # a 56 GB download per pod.
    HF_HOME=/hf_cache

RUN mkdir -p /jax_cache /hf_cache

COPY docker/serve_qwen38.sh /serve_qwen38.sh
RUN chmod +x /serve_qwen38.sh

EXPOSE 8000
ENTRYPOINT ["/serve_qwen38.sh"]
CMD []
